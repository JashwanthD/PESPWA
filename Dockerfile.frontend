# ─────────────────────────────────────────────────────────────
# PESCE Intelligence -- Vite PWA Frontend
# Build context: workspace root (d:\games\PES placement PWA\)
# Multi-stage: Node 20 builds, Nginx serves
# ─────────────────────────────────────────────────────────────

# ── Stage 1: Build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Declare build-time env vars for Vite (VITE_* are embedded at build time)
# Pass these via: docker compose build --build-arg VITE_SUPABASE_URL=...
# OR inject from .env using docker-compose env_file on the build service
ARG VITE_SUPABASE_INTELLIGENCE_URL
ARG VITE_SUPABASE_INTELLIGENCE_ANON_KEY
ARG VITE_SUPABASE_HIRING_URL
ARG VITE_SUPABASE_HIRING_ANON_KEY

# Make them available to the Vite build process
ENV VITE_SUPABASE_INTELLIGENCE_URL=$VITE_SUPABASE_INTELLIGENCE_URL
ENV VITE_SUPABASE_INTELLIGENCE_ANON_KEY=$VITE_SUPABASE_INTELLIGENCE_ANON_KEY
ENV VITE_SUPABASE_HIRING_URL=$VITE_SUPABASE_HIRING_URL
ENV VITE_SUPABASE_HIRING_ANON_KEY=$VITE_SUPABASE_HIRING_ANON_KEY

# Copy package files first for better layer caching
COPY pesce-insight-nexus-main/pesce-insight-nexus-main/package.json \
     pesce-insight-nexus-main/pesce-insight-nexus-main/package-lock.json ./

# Install all deps (devDeps needed for Vite build)
RUN npm ci --prefer-offline

# Copy source code (note: .env is excluded via .dockerignore)
COPY pesce-insight-nexus-main/pesce-insight-nexus-main/ .

# Build production bundle — Vite embeds VITE_* vars at this step
RUN npm run build

# ── Stage 2: Serve with Nginx ────────────────────────────────
FROM nginx:alpine AS runtime

# Remove default nginx site config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom Nginx config (SPA routing + /api proxy to backend)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built Vite assets from Stage 1
# Note: VITE_* secrets are now compiled into JS — not readable as env vars
COPY --from=builder /app/dist /usr/share/nginx/html

# Create output dir placeholder (populated at runtime via shared Docker volume)
RUN mkdir -p /usr/share/nginx/html/output

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
